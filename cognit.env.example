# Public deployment settings for the Cognit website.
#
# Copy this file to `cognit.env` for a local or Docker deployment:
#
#   cp cognit.env.example cognit.env
#
# `cognit.env` is ignored by Git. Only public presentation and hosted-form settings belong here.
# Do not put SMTP passwords, API keys, database passwords, or private connection strings in this
# file. The recipient mailbox and provider credentials are configured in the provider dashboard.

# Docker host port. The container always listens on port 80.
COGNIT_HOST_PORT="8080"

# Public site identity.
COGNIT_SITE_URL="https://www.your-domain.example"
COGNIT_CONTACT_EMAIL="consult@cognit.com"
COGNIT_LOCATION="[Your city / region]"
COGNIT_LEGAL_DETAILS="[Replace with your legal or business details]"

# Hosted form and email delivery provider.
# Supported examples include Formspree, Netlify Forms, Basin, and similar services.
COGNIT_FORM_PROVIDER="formspree"
COGNIT_FORM_ENDPOINT="https://formspree.io/f/REPLACE_WITH_FORM_ID"
COGNIT_FORM_SUBJECT="Cognit Consultation Inquiry"
COGNIT_FORM_REDIRECT_URL=""
